{
	"name": "react-group",
	"description": "React component to render collection of items separated by space or other separator",
	"version": "0.0.0-development",
	"homepage": "https://github.com/sapegin/react-group",
	"author": {
		"name": "Artem Sapegin",
		"url": "http://sapegin.me/"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/sapegin/react-group.git"
	},
	"bugs": {
		"url": "https://github.com/sapegin/react-group/issues"
	},
	"license": "MIT",
	"main": "index.js",
	"types": "index.d.ts",
	"files": [
		"index.js",
		"index.d.ts"
	],
	"engines": {
		"node": ">=6"
	},
	"dependencies": {
		"prop-types": "^15.8.1"
	},
	"peerDependencies": {
		"react": ">=18.0.0"
	},
	"devDependencies": {
		"@testing-library/react": "^15.0.7",
		"eslint": "^8.57.0",
		"eslint-config-tamia": "^8.1.3",
		"gh-pages": "^2.0.1",
		"husky": "^9.0.11",
		"jest": "^29.7.0",
		"jest-environment-jsdom": "^29.7.0",
		"lint-staged": "^15.2.2",
		"prettier": "^3.2.5",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-styleguidist": "13.1.2",
		"webpack": "5.91.0"
	},
	"scripts": {
		"pretest": "npm run lint",
		"test": "jest",
		"posttest": "npm run format",
		"test:watch": "jest --watch",
		"lint": "eslint . --cache --fix",
		"start": "styleguidist server",
		"styleguide:build": "styleguidist build",
		"deploy": "gh-pages -d docs",
		"gh-pages": "npm run styleguide:build && npm run deploy",
		"format": "prettier --write \"**/*.{js,md}\""
	},
	"keywords": [
		"react",
		"jsx",
		"group",
		"list",
		"separator",
		"collection",
		"space"
	],
	"jest": {
		"testEnvironment": "jest-environment-jsdom"
	},
	"lint-staged": {
		"*.{js,md}": [
			"prettier --write",
			"git add"
		],
		"*.js": [
			"eslint --fix",
			"git add"
		]
	}
}
